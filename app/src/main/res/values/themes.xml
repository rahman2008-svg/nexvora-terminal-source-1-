<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
     https://material.io/develop/android/theming/dark
    -->

    <!-- TermuxApp Light DarkActionBar theme. -->
    <style name="Theme.TermuxApp.Light.DarkActionBar" parent="Theme.BaseActivity.Light.DarkActionBar"/>
    <!-- TermuxApp Light NoActionBar theme. -->
    <style name="Theme.TermuxApp.Light.NoActionBar" parent="Theme.BaseActivity.Light.NoActionBar"/>

    <!-- TermuxApp DayNight DarkActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.DarkActionBar" parent="Theme.BaseActivity.DayNight.DarkActionBar"/>
    <!-- TermuxApp DayNight NoActionBar theme. -->
    <style name="Theme.TermuxApp.DayNight.NoActionBar" parent="Theme.BaseActivity.DayNight.NoActionBar"/>


    <!-- TermuxActivity DayNight NoActionBar theme. -->
    <style name="Theme.TermuxActivity.DayNight.NoActionBar" parent="Theme.TermuxApp.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/nexvora_black</item>
        <item name="colorPrimaryVariant">@color/nexvora_black</item>
        <item name="colorSecondary">@color/nexvora_cyan</item>
        <item name="colorAccent">@color/nexvora_cyan</item>

        <item name="android:windowBackground">@color/nexvora_black</item>

        <!-- Avoid action mode toolbar pushing down terminal content when
             selecting text on pre-6.0 (non-floating toolbar). -->
        <item name="android:windowActionModeOverlay">true</item>

        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>

        <!-- https://developer.android.com/training/tv/start/start.html#transition-color -->
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>

        <!-- Left drawer. -->
        <item name="buttonBarButtonStyle">@style/TermuxActivity.Drawer.ButtonBarStyle.Dark</item>
        <item name="termuxActivityDrawerBackground">@color/nexvora_surface</item>
        <item name="termuxActivityDrawerImageTint">@color/nexvora_cyan</item>

        <!-- Extra keys colors. -->
        <item name="extraKeysButtonTextColor">@color/nexvora_cyan</item>
        <item name="extraKeysButtonActiveTextColor">@color/nexvora_purple</item>
        <item name="extraKeysButtonBackgroundColor">@color/nexvora_surface</item>
        <item name="extraKeysButtonActiveBackgroundColor">@color/nexvora_surface_variant</item>
    </style>


    <!-- NexVora dark-luxury theme for NexVora-owned screens (Welcome, Dashboard, About). -->
    <style name="Theme.NexVora" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/nexvora_cyan</item>
        <item name="colorPrimaryVariant">@color/nexvora_cyan</item>
        <item name="colorOnPrimary">@color/nexvora_black</item>
        <item name="colorSecondary">@color/nexvora_purple</item>
        <item name="colorSecondaryVariant">@color/nexvora_purple</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/nexvora_surface</item>
        <item name="colorOnSurface">@color/nexvora_text_primary</item>
        <item name="android:colorBackground">@color/nexvora_black</item>
        <item name="android:windowBackground">@color/nexvora_black</item>
        <item name="android:statusBarColor">@color/nexvora_black</item>
        <item name="android:navigationBarColor">@color/nexvora_black</item>
        <item name="android:textColorPrimary">@color/nexvora_text_primary</item>
        <item name="android:textColorSecondary">@color/nexvora_text_secondary</item>
    </style>

    <!-- Splash: shown by the window while the launcher activity starts (no extra dependency needed). -->
    <style name="Theme.NexVora.Splash" parent="Theme.NexVora">
        <item name="android:windowBackground">@drawable/nexvora_splash</item>
    </style>

</resources>
